# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip


source 'https://github.com/zoho/zpayments-ios-sdk.git'
source 'https://github.com/CocoaPods/Specs.git'


platform :ios, 15.6
prepare_react_native_project!

project 'smartstayOwnerApp',
  'DevDebug' => :debug,
  'DevRelease' => :release,
  'ProdDebug' => :debug,
  'ProdRelease' => :release

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'smartstayOwnerApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )


  pod 'FirebaseMessaging', '~> 12.0', :modular_headers => true
  pod 'FirebaseCrashlytics', '~> 12.0'
  pod 'FirebaseAnalytics', '~> 12.0'

  pod 'GoogleUtilities', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
installer.pods_project.targets.each do |target|
    if target.name == 'fmt'
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end

    # Xcode 27 fails the build when a target's deployment target is below iOS 15.0.
    # Some pods' resource bundles still declare iOS 9-13, so raise those to the
    # app's minimum (keep in sync with `platform :ios` above).
    target.build_configurations.each do |config|
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current && Gem::Version.new(current.to_s) < Gem::Version.new('15.6')
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.6'
      end
    end
  end

  end
end
